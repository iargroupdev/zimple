<Window x:Class="Zimple.WindowAllinOne"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZimpleTesting"
        Height="620"
        Width="860">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Background="WhiteSmoke">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Branding -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">

                <Image Source="/zimple.png"
                       Height="55"
                       Margin="0,0,10,0"/>

                <StackPanel>
                    <TextBlock Text="ZimpleTesting"
                               FontSize="25"/>
                    <TextBlock Text="a Zeugma/CIMPLE integration"
                               FontSize="15"
                               Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">

                <Button Content="Add and remove PLCs"
                        Width="160"
                        Height="30"
                        Margin="0,0,10,0"
                        Click="OpenConfiguration_Click"/>

                <Button Content="Connect All"
                        Width="120"
                        Height="30"
                        Click="ConnectAll_Click"/>
            </StackPanel>

        </Grid>

        <!-- CONTENT AREA -->
        <Grid Grid.Row="1" Margin="10">

            <!-- Message when no PLCs exist -->
            <TextBlock x:Name="noPlcMessage"
                       Text="No PLCs configured. Click 'Add and remove PLCs' to create one."
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- Tabs -->
            <TabControl x:Name="tabControlOps"
                        Visibility="Collapsed"/>

        </Grid>

    </Grid>
</Window>
