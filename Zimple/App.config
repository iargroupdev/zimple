<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="Zimple.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <appSettings>
        <!--
            When true, trigger 8 reads measurements from:
            {OP}.Serial_MoveOutAndTestResults.MeasureDataPacked

            Expected row format:
            HighLimit|LowLimit|MeasureKey|MeasureNotes|MeasureValue|Position|Result|Tolerance|UnitOfMeasure

            Keep false until the PLC exposes this packed string array.
        -->
        <add key="UsePackedMoveOutMeasureData" value="false"/>
    </appSettings>
    <startup> 
        
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/></startup>
    <userSettings>
        <Zimple.Properties.Settings>
            <setting name="IpPart1" serializeAs="String">
                <value/>
            </setting>
            <setting name="IpPart2" serializeAs="String">
                <value/>
            </setting>
            <setting name="IpPart3" serializeAs="String">
                <value/>
            </setting>
            <setting name="IpPart4" serializeAs="String">
                <value/>
            </setting>
            <setting name="StationName" serializeAs="String">
                <value/>
            </setting>
            <setting name="UserName" serializeAs="String">
                <value/>
            </setting>
            <setting name="Password" serializeAs="String">
                <value/>
            </setting>
        </Zimple.Properties.Settings>
    </userSettings>
</configuration>
